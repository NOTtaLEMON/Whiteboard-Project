# Handwriting OCR: a pretrained Qwen2-VL model served by ocr-service/ (see ocr-service/README.md).
# Defaults to http://127.0.0.1:8788 locally. On Vercel set it to a hosted instance.
# OCR_SERVICE_URL=http://127.0.0.1:8788
# OCR_MODEL=Qwen/Qwen2-VL-2B-Instruct
# OCR_TIMEOUT_MS=180000

# Optional: local lesson archive, relative to the app directory or an absolute path.
# SNAPSHOT_DIR=snapshots
# Hosted lesson archive (server-only; never prefix these with VITE_):
# SNAPSHOT_GITHUB_REPOSITORY=ksu-gitreaper807/Craft-N-Code-Karnataka
# SNAPSHOT_GITHUB_BRANCH=boardroom-lessons
# SNAPSHOT_GITHUB_TOKEN=fine-grained-token-with-contents-read-write
# For a trusted Vercel frontend + separate Docker API (set these only on the API server):
# BOARDROOM_APP_ORIGIN=https://board-of-c.vercel.app
# BOARDROOM_API_HOST=api.example.com
# Behind a reverse proxy (Caddy, nginx) set this so rate limits apply per visitor, not to the proxy as a whole:
# BOARDROOM_TRUST_PROXY=1

# Vercel hosted execution (see docs/vercel-serverless.md):
# WANDBOX_API_URL=https://wandbox.org/api
# WANDBOX_CPP_COMPILER=gcc-head
# WANDBOX_PYTHON_COMPILER=cpython-3.13.8
